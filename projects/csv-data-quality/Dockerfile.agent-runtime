FROM ghcr.io/astral-sh/uv:0.11.12 AS uv

FROM rust:latest AS tuff-builder

ARG TUFF_REPOSITORY=https://github.com/kannandreams/tuff.git
ARG TUFF_REF=main
RUN cargo install --git "${TUFF_REPOSITORY}" --branch "${TUFF_REF}" \
  tuffcli --locked

FROM python:3.12-slim

COPY --from=uv /uv /uvx /bin/
COPY --from=tuff-builder /usr/local/cargo/bin/tuff /usr/local/bin/tuff

WORKDIR /runtime
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --no-install-project
COPY runtime ./runtime

ENV PATH="/runtime/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
CMD ["bash"]
