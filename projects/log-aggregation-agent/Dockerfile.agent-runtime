FROM ghcr.io/astral-sh/uv:0.11.12 AS uv

FROM rust:latest AS tuff-builder

ARG TUFF_REPOSITORY=https://github.com/kannandreams/tuff.git
ARG TUFF_REF=main
RUN cargo install --git "${TUFF_REPOSITORY}" --branch "${TUFF_REF}" tuffcli --locked

FROM python:3.12-slim

COPY --from=uv /uv /uvx /bin/
COPY --from=tuff-builder /usr/local/cargo/bin/tuff /usr/local/bin/tuff
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --no-install-project
COPY log_aggregation ./log_aggregation
COPY runtime ./runtime
COPY TASK.md tuff.config.json ./
COPY data ./data

ENV PATH="/workspace/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PROJECT_ROOT=/workspace
ENTRYPOINT ["python", "-m", "runtime.container"]
